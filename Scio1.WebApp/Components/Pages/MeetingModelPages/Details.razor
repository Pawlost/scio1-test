@page "/meetingmodels/details"
@using Microsoft.EntityFrameworkCore
@using Scio1.BL.Models
@using Scio1.DAL
@using Scio1.DAL.Entities
@inject IDbContextFactory<Scio1DbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Details</PageTitle>

<h1>Details</h1>

<div>
    <h2>MeetingModel</h2>
    <hr />
    @if (meetingmodel is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">Start</dt>
            <dd class="col-sm-10">@meetingmodel.Start</dd>
            <dt class="col-sm-2">End</dt>
            <dd class="col-sm-10">@meetingmodel.End</dd>
            <dt class="col-sm-2">Title</dt>
            <dd class="col-sm-10">@meetingmodel.Title</dd>
            <dt class="col-sm-2">Description</dt>
            <dd class="col-sm-10">@meetingmodel.Description</dd>
        </dl>
        <div>
            <a href="@($"/meetingmodels/edit?id={meetingmodel.Id}")">Edit</a> |
            <a href="@($"/meetingmodels")">Back to List</a>
        </div>
    }
</div>

@code {
    private MeetingEntity? meetingmodel;

    [SupplyParameterFromQuery]
    private Guid Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        meetingmodel = await context.MeetingModel.FirstOrDefaultAsync(m => m.Id == Id);

        if (meetingmodel is null)
        {
            NavigationManager.NotFound();
        }
    }
}
